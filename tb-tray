#!/usr/bin/env python3
"""tb-tray - Turtle Beach Stealth 700 Gen 3 battery indicator for the tray.

Ayatana AppIndicator companion to tb-heal: polls `tb-heal --json` every
120 s and shows the headset battery as a tray icon - the percent drawn
into the icon, color-coded - plus a status menu.

Icon:    green = linked, amber = charging, red = linked + <=20%,
         gray = not linked / transmitter / tooling problem
Label:   "90%" next to the icon (where the shell supports labels)
Menu:    live status line / Refresh now / Copy status / Run tb-heal /
         Kick audio / Quit

Polling is report-only by default (--no-heal): a long-running daemon
that heals every cycle would fight deliberate output switching. Pass
--heal to make the tray keep the TB sink default/unmuted as well.

tb-heal does the real work; this is only the face. Requires:
libayatana-appindicator, python-gobject, tb-heal on PATH (~/.local/bin).
"""
import json
import os
import subprocess
import sys
import threading
import time

import gi
gi.require_version("AyatanaAppIndicator3", "0.1")
gi.require_version("Gtk", "3.0")
from gi.repository import AyatanaAppIndicator3 as AI  # noqa: E402
from gi.repository import GLib, Gtk  # noqa: E402

VERSION = "1.0.4"
ICON_DIR = os.path.expanduser("~/.cache/tb-tray")
LOW_BATT, REARM_BATT = 20, 25
COLORS = {"ok": "#3fb950", "charging": "#e3b341",
          "low": "#f85149", "off": "#8b949e"}


# ---------------------------------------------------------------- icons

ICON_SVG = """<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24">
<circle cx="12" cy="12" r="11" fill="{color}"/>
<text x="12" y="{y}" text-anchor="middle" fill="#ffffff"
 font-family="sans-serif" font-weight="bold" font-size="{fs}">{txt}</text>
</svg>"""


def icon_path(kind, txt, fs):
    """Icon file for a state, generated on demand and reused after that."""
    name = "%s-%s.svg" % (kind, txt if txt else "dash")
    path = os.path.join(ICON_DIR, name)
    if not os.path.exists(path):
        y = 12 + fs * 0.36
        with open(path, "w") as f:
            f.write(ICON_SVG.format(color=COLORS[kind], txt=txt or "&#8212;",
                                     fs=fs, y=round(y, 1)))
    return path


def icon_for(st):
    """(kind, txt, fs) for a tb-heal status dict."""
    if not st.get("ok") and st.get("state") == "NO_DONGLE":
        return "off", "", 14
    batt = st.get("battery")
    if st.get("link") and batt is not None:
        if st.get("charging"):
            kind = "charging"
        else:
            kind = "low" if batt <= LOW_BATT else "ok"
        fs = 10 if batt >= 100 else 13
        return kind, str(batt), fs
    return "off", "", 14


# ---------------------------------------------------------------- status text

def status_text(st):
    name = st.get("name") or "Stealth 700 Gen 3"
    state = st.get("state", "?")
    batt = st.get("battery")
    pct = "%d%%" % batt if batt is not None else "?"
    if state == "LINKED":
        s = "%s: linked, battery %s%s" % (
            name, pct, " (charging)" if st.get("charging") else "")
        if st.get("wired_usb"):
            s += " - on the charge cable"
    elif state == "UNLINKED":
        s = ("%s: NOT LINKED (headset off or out of range), "
             "last battery %s" % (name, pct))
    elif state == "WEDGED":
        s = "transmitter not answering - replug the dongle"
    elif state == "NO_SINK":
        s = "dongle present but its sound card is not up yet"
    elif state == "BUSY":
        s = "transmitter busy - another status query is running"
    elif state == "NO_ACCESS":
        s = ("cannot open the transmitter over USB "
             "(no permission, or an unrelated app holds it)")
    elif state == "NO_HIDAPI":
        s = "hidapi library missing: %s" % st.get("error", "")
    elif state == "NO_HEAL":
        s = "tb-heal not found on PATH (install it first)"
    elif state == "FAIL":
        s = "tb-heal query failed (timeout or bad output)"
    elif state == "NO_DONGLE":
        s = "transmitter not on USB"
    else:
        s = "%s: %s" % (name, state)
    if st.get("healed"):
        s += " (healed: %s)" % "; ".join(st["healed"])
    return s


def fetch(heal):
    """One tb-heal --json poll. Never raises; returns a status dict.
    A transient failure (USB claim lost to a concurrent query - tb-heal
    serializes on its lock, but a foreign app can still race) is retried
    once before it is allowed onto the screen."""
    def once():
        try:
            r = subprocess.run(["tb-heal", "--json"] + ([] if heal
                                else ["--no-heal"]),
                               capture_output=True, text=True, timeout=15)
            st = json.loads(r.stdout)
            st["_updated"] = time.strftime("%H:%M")
            return st
        except FileNotFoundError:
            return {"state": "NO_HEAL", "ok": False,
                    "_updated": time.strftime("%H:%M")}
        except (OSError, ValueError, subprocess.TimeoutExpired):
            return {"state": "FAIL", "ok": False,
                    "_updated": time.strftime("%H:%M")}
    st = once()
    if st.get("state") in ("NO_ACCESS", "BUSY"):
        time.sleep(2)
        st = once()
    return st


# ---------------------------------------------------------------- tray

class Tray:
    def __init__(self, interval, heal):
        self.interval, self.heal = interval, heal
        self.st = {}
        self.low_notified = False
        self.prev_link = None
        self.ind = AI.Indicator.new("tb-tray", icon_path("off", "", 14),
                                    AI.IndicatorCategory.HARDWARE)
        self.ind.set_status(AI.IndicatorStatus.ACTIVE)
        self.ind.set_title("Turtle Beach battery")

        menu = Gtk.Menu()
        self.item_status = Gtk.MenuItem(label="querying tb-heal...")
        menu.append(self.item_status)
        item = Gtk.MenuItem(label="Refresh now")
        item.connect("activate", lambda *_: self.kick())
        menu.append(item)
        item = Gtk.MenuItem(label="Copy status")
        item.connect("activate", self.copy_status)
        menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        item = Gtk.MenuItem(label="Run tb-heal")
        item.connect("activate", self.run_tb_heal)
        menu.append(item)
        item = Gtk.MenuItem(label="Kick audio (no-sound fix)")
        item.connect("activate", lambda *_: threading.Thread(
            target=self.kick_audio, args=("manual",),
            daemon=True).start())
        menu.append(item)
        menu.append(Gtk.SeparatorMenuItem())
        item = Gtk.MenuItem(label="Quit")
        item.connect("activate", lambda *_: GLib.main_loop_quit(
            GLib.MainLoop.default()))
        menu.append(item)
        menu.show_all()
        self.ind.set_menu(menu)

    # -- updates ----------------------------------------------------------

    def apply(self, st):
        self.st = st
        kind, txt, fs = icon_for(st)
        path = icon_path(kind, txt, fs)
        self.ind.set_icon_full(path, "turtle beach battery")
        self.ind.set_label("%s%%" % txt if txt else "", "100%")
        line = status_text(st)
        if st.get("_updated"):
            line += "  [%s]" % st["_updated"]
        self.item_status.set_label(line)
        self.ind.set_tooltip_full(path, "Turtle Beach", line)
        self.low_battery(st)
        self.link_changed(st)
        print("tb-tray: %s" % line, flush=True)

    def link_changed(self, st):
        """Kick the dongle's audio pipe once when the headset links
        again - the dongle fumbles stream transitions around a
        power-on and audio stays dead until the pipe is reopened."""
        linked = st.get("state") == "LINKED"
        if self.prev_link is not None and linked and not self.prev_link:
            threading.Thread(target=self.kick_audio,
                             args=("link re-established",),
                             daemon=True).start()
        self.prev_link = linked

    def kick_audio(self, reason):
        """Full card-profile flip - closes and reopens the dongle's
        whole USB audio interface (~2 s). The suspend-toggle of 1.0.3
        was sometimes not enough for a wedged dongle (a day of live
        wedges: kicks fired 8x, audio still died); the profile flip is
        the user-proven heavy remedy."""
        try:
            r = subprocess.run(["pactl", "list", "short", "cards"],
                               capture_output=True, text=True, timeout=5)
            card = next((l.split()[1] for l in r.stdout.splitlines()
                         if "Turtle_Beach" in l), None)
            if not card:
                print("tb-tray: kick: no Turtle Beach card found",
                      flush=True)
                return
            r = subprocess.run(["pactl", "list", "cards"],
                               capture_output=True, text=True, timeout=5)
            profile, cur = None, None
            for line in r.stdout.splitlines():
                ls = line.strip()
                if ls.startswith("Name: "):
                    cur = ls.split(": ", 1)[1]
                elif cur == card and ls.startswith("Active Profile: "):
                    profile = ls.split(": ", 1)[1].strip()
                    break
            if not profile:
                profile = "output:analog-stereo+input:mono-fallback"
            alt = ("output:iec958-stereo" if "analog" in profile
                   else "output:analog-stereo+input:mono-fallback")
            for prof in (alt, profile):
                rc = subprocess.run(["pactl", "set-card-profile",
                                      card, prof],
                                     capture_output=True, text=True,
                                     timeout=10)
                if rc.returncode != 0:
                    print("tb-tray: kick: profile flip failed: %s"
                          % (rc.stderr.strip() or "unknown"), flush=True)
                    return
                time.sleep(0.5)
            print("tb-tray: audio pipe kicked (%s)" % reason, flush=True)
        except OSError as e:
            print("tb-tray: kick failed: %s" % e, flush=True)

    def low_battery(self, st):
        """One toast when the battery crosses LOW_BATT, rearmed at
        REARM_BATT or on charge - so a hovering 20% cannot spam."""
        batt = st.get("battery")
        if not st.get("link") or batt is None:
            return
        if st.get("charging") or batt >= REARM_BATT:
            self.low_notified = False
        elif batt <= LOW_BATT and not self.low_notified:
            self.low_notified = True
            subprocess.run(["notify-send", "-u", "critical", "-i",
                            "battery-caution-symbolic",
                            "Turtle Beach battery low",
                            "%s%% left - plug the charge cable in" % batt],
                           capture_output=True)

    def refresh(self):
        """Poll in a worker thread so the UI never blocks on the HID
        exchange (~1.5 s), then apply on the main loop."""
        def work():
            st = fetch(self.heal)
            GLib.idle_add(self.apply, st)
        threading.Thread(target=work, daemon=True).start()
        return GLib.SOURCE_CONTINUE

    def kick(self):
        self.refresh()

    # -- menu actions -----------------------------------------------------

    def copy_status(self, *_):
        subprocess.run(["wl-copy", status_text(self.st)],
                       capture_output=True)

    def run_tb_heal(self, *_):
        def work():
            try:
                r = subprocess.run(["tb-heal"], capture_output=True,
                                   text=True, timeout=30)
                body = (r.stdout or r.stderr).strip() or "(no output)"
            except (OSError, subprocess.TimeoutExpired) as e:
                body = "tb-heal failed: %s" % e
            subprocess.run(["notify-send", "-i", "audio-headset-symbolic",
                            "tb-heal", body[:900]], capture_output=True)
            self.kick()
        threading.Thread(target=work, daemon=True).start()


def already_running():
    """True if another tb-tray is alive (autostart + manual launch would
    otherwise stack two icons)."""
    me = os.getpid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == me:
            continue
        try:
            with open("/proc/%s/cmdline" % pid, "rb") as f:
                argv = f.read().split(b"\0")
            if argv and os.path.basename(argv[0].decode(errors="replace")) \
                    == "tb-tray":
                return True
        except OSError:
            continue
    return False


def main():
    import argparse
    ap = argparse.ArgumentParser(
        description="Turtle Beach Stealth 700 Gen 3 battery tray indicator")
    ap.add_argument("--interval", type=int, default=120, metavar="S",
                    help="poll interval in seconds (default 120, min 10)")
    ap.add_argument("--heal", action="store_true",
                    help="also keep the TB sink default/unmuted each poll "
                         "(default: report only)")
    ap.add_argument("--version", action="version",
                    version="tb-tray %s" % VERSION)
    args = ap.parse_args()

    if already_running():
        print("tb-tray: already running, nothing to do", file=sys.stderr)
        return 1
    os.makedirs(ICON_DIR, exist_ok=True)
    icon_path("off", "", 14)

    tray = Tray(max(10, args.interval), args.heal)
    loop = GLib.MainLoop()

    import signal
    for sig in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, loop.quit)
    tray.refresh()
    GLib.timeout_add_seconds(max(10, args.interval), tray.refresh)
    try:
        loop.run()
    finally:
        tray.ind.set_status(AI.IndicatorStatus.PASSIVE)
    return 0


if __name__ == "__main__":
    sys.exit(main())
